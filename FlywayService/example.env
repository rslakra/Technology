# Application
APP_ENV=develop
APP_HOST=0.0.0.0
APP_PORT=8016
CONTEXT_PATH=/account-service
REST_PREFIX=/rest
DEFAULT_AUDITOR="Rohtash Lakra"

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5444
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=Accounts
DATABASE_TEST_NAME=AccountsTest

# Flyway
POSTGRES_DATA_DIR=~/Downloads/Data/PostgreSQL/Accounts
FLYWAY_URL=jdbc:postgresql://localhost:5444/Accounts
FLYWAY_USER=postgres
FLYWAY_PASSWORD=postgres
FLYWAY_LOCATIONS=filesystem:flyway

# Migration
AUTO_MIGRATE=true
